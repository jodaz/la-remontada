---
import Layout from "../../layouts/Layout.astro";
import Meme from "../../components/Meme.astro";
import BotonDescarga from "../../components/BotonDescarga.astro";
import NotaRealidad from "../../components/NotaRealidad.astro";
import { memes, modelo } from "../../lib/datos.ts";

const MEME = "puertas" as const;
const numeros = `${memes[MEME].ruta}/numeros`;
const h1 = modelo.proxima
  ? `La muerte toca puertas: la próxima víctima es ${modelo.proxima.pais.nombre}`
  : `La muerte toca puertas: ${modelo.venezuela.pais.nombre} está en el puesto ${modelo.venezuela.puesto}`;
---

<Layout
  titulo="La muerte tocando puertas · La Remontada"
  descripcion={modelo.notas.puertas}
  og="/og/victima.png"
  ruta="/victima"
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={`/memes/${memes[MEME].imagenWebp}`}
    type="image/webp"
    fetchpriority="high"
  />
  <h1 class="visualmente-oculto">{h1}</h1>
  <section class="pantalla-meme">
    <Meme meme={MEME} />
    <BotonDescarga meme={MEME} />
    <NotaRealidad texto={modelo.notas.puertas} />
    <a class="boton-numeros" href={numeros}>Ver los números</a>
  </section>
</Layout>
